props { symbol, small = false }: { symbol: string; small?: boolean }
span(className={`token-icon token-${symbol.toLowerCase()} ${small ? 'small' : ''}`} aria-hidden="true")
  if symbol === 'ETH' || symbol === 'SEP'
    fragment
      svg(width="20" height="25" viewBox="0 0 20 30" fill="currentColor")
        path(d="M10 0 0 15l10 6 10-6L10 0Zm0 23L0 17l10 13 10-13-10 6Z")
  elseif symbol === 'BTC'
    fragment
      | ₿
  elseif symbol === 'USDC'
    fragment
      | $
  elseif symbol === 'USDT'
    fragment
      | ₮
  else
    fragment
      svg(width="25" height="22" viewBox="0 0 28 24" fill="none" stroke="currentColor" strokeWidth="2.6")
        path(d="m2 8 5-3 5 3v6l-5 3-5-3V8Zm14 2 5-3 5 3v6l-5 3-5-3v-6ZM12 10l4 3")
