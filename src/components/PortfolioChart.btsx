import { useRef, useState } from 'octane'
import { useWalletTimeline } from '../hooks/use-wallet-timeline'
import { TIMELINE_PERIODS, timelinePoints, timelinePath, type TimelinePeriod } from '../lib/wallet-timeline'
import type { NetworkKey } from '../lib/appkit/networks'
module
  const series = [{ key: 'total' as const, label: 'Total activity', color: '#439cf4' }, { key: 'sent' as const, label: 'Sent', color: '#ff694f' }, { key: 'received' as const, label: 'Received', color: '#23c88a' }];
props { preview, hidden, network, address }: { preview: boolean; hidden: boolean; network: NetworkKey; address?: string }
setup
  const [period, setPeriod] = useState<TimelinePeriod>('1W');
  const [hoverIndex, setHoverIndex] = useState<number | undefined>(undefined);
  const referenceTime = useRef(Date.now());
  const timeline = useWalletTimeline(network, preview ? undefined : address);
  const end = timeline.data?.updated ?? referenceTime.current;
  const previewEvents = Array.from({ length: 120 }, (_, index) => ({ hash: `preview-${index}`, timestamp: end - (120 - index) * 6 * 3_600_000, received: index % 3 !== 0, sent: index % 3 === 0 }));
  const points = timelinePoints(preview ? previewEvents : timeline.data?.events ?? [], period, end);
  const latest = points[points.length - 1]!;
  const maximum = Math.max(1, latest.total);
  const hoverX = (hoverIndex ?? 32) / 32 * 660;
  const hoverPercent = Math.max(18, Math.min(82, (hoverIndex ?? 32) / 32 * 100));
  const hovered = hoverIndex === undefined ? undefined : points[hoverIndex];
  const formatDate = (timestamp: number) => new Date(timestamp).toLocaleString('en-US', period === '1D' ? { hour: 'numeric', minute: '2-digit' } : { month: 'short', day: 'numeric' });
  const available = preview || Boolean(timeline.data);
  const moveHover = (event: PointerEvent) => { const rect = (event.currentTarget as HTMLElement).getBoundingClientRect(); setHoverIndex(Math.max(0, Math.min(32, Math.round((event.clientX - rect.left) / rect.width * 32)))); };
  const keyboardHover = (event: KeyboardEvent) => {
    if (['ArrowLeft', 'ArrowRight', 'Home', 'End', 'Escape'].includes(event.key)) {
      event.preventDefault();
      setHoverIndex(event.key === 'Escape' ? undefined : event.key === 'Home' ? 0 : event.key === 'End' ? 32 : Math.max(0, Math.min(32, (hoverIndex ?? 32) + (event.key === 'ArrowLeft' ? -1 : 1))));
    }
  };

.chart-section.wallet-timeline
  .chart-toolbar
    .chart-legend
      span Wallet timeline
      if preview
        fragment
          span.chart-preview Illustrative activity
    .periods(aria-label="Chart period")
      each item in TIMELINE_PERIODS key item
        fragment
          button(type="button" className={period === item ? 'active' : ''} aria-pressed={period === item} onClick={() => { setPeriod(item); setHoverIndex(undefined); }}) #{item}
  if available
    fragment
      .timeline-metrics
        each item in series key item.key
          fragment
            .timeline-metric
              .timeline-metric-label
                span.timeline-dot(style={{ backgroundColor: item.color }})
                span #{item.label}
              strong #{hidden ? '•••' : latest[item.key].toLocaleString('en-US')}
      .chart-plot.timeline-plot(tabIndex={0} role="group" aria-label="Wallet activity timeline. Use left and right arrow keys to explore dates." onPointerMove={moveHover} onPointerLeave={() => setHoverIndex(undefined)} onFocus={() => setHoverIndex(32)} onBlur={() => setHoverIndex(undefined)} onKeyDown={keyboardHover})
        svg.portfolio-chart(viewBox="0 0 660 200" preserveAspectRatio="none" role="img" aria-label={`${preview ? 'Illustrative' : 'Onchain'} cumulative wallet activity over ${period}: ${hidden ? 'counts hidden' : `${latest.total} transactions, ${latest.received} received, ${latest.sent} sent`}`})
          path.timeline-area(d={`${timelinePath(points, 'received', maximum)} L660 194 L0 194 Z`})
          each item in series key item.key
            fragment
              path.chart-line(d={timelinePath(points, item.key, maximum)} style={{ stroke: item.color }})
              circle.chart-end(cx="660" cy={174 - latest[item.key] / maximum * 150} r="3.5" style={{ fill: item.color }})
          if hovered && !hidden
            fragment
              path.chart-crosshair(d={`M${hoverX} 12v176`})
              each item in series key item.key
                fragment
                  circle(cx={hoverX} cy={174 - hovered[item.key] / maximum * 150} r="4" fill={item.color} stroke="var(--panel)" strokeWidth="2")
        if hovered && !hidden
          fragment
            .chart-tooltip.timeline-tooltip(style={{ left: `${hoverPercent}%` }} role="status")
              strong #{new Date(hovered.timestamp).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })}
              each item in series key item.key
                fragment
                  span
                    i.timeline-dot(style={{ backgroundColor: item.color }})
                    | #{item.label}
                    b #{hovered[item.key]}
      .chart-dates.timeline-dates
        each index in [0, 8, 16, 24, 32] key index
          fragment
            span #{formatDate(points[index]!.timestamp)}
      .timeline-source(aria-live="polite")
        if preview
          fragment
            span Demo activity · connect your wallet for its onchain timeline.
      p.timeline-note.hidden Counts accumulate from the start of the selected period. A hash counts once; self-transfers appear in both Sent and Received. Sent includes reverted attempts. Internal transfers and NFTs are excluded.
  else
    fragment
      .chart-empty(role="status")
        .chart-empty-line
        p #{network === 'bitcoin' ? 'Bitcoin timeline is unavailable.' : timeline.loading ? 'Reading your wallet’s timeline…' : 'Wallet timeline unavailable.'}
        span #{network === 'bitcoin' ? 'Choose an EVM network to explore Etherscan activity.' : timeline.error ?? 'Connect your wallet to explore its activity.'}
        if timeline.error && network !== 'bitcoin'
          fragment
            button.text-button(type="button" onClick={timeline.refetch}) Retry history
